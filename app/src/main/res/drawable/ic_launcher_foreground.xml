<?xml version="1.0" encoding="utf-8"?>
<!-- KITT Launcher icon: the car's black nose with the red scanner sweeping across it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="60"
        android:scaleX="1.15"
        android:scaleY="1.15"
        android:translateY="-4">
    <!-- Nose: sloped hood over a wide front panel. -->
    <path
        android:fillColor="#FF151313"
        android:pathData="M25,63L33,49.5H75L83,63L79.5,71H28.5Z"
        android:strokeColor="#FF4A4240"
        android:strokeWidth="1.2"
        android:strokeLineJoin="round" />
