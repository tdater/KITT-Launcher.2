    <path
        android:fillColor="#FF000000"
        android:pathData="M30,53.5h48v6h-48z" />
    <!-- Glow around the scanner head. -->
    <path android:pathData="M40,48h28v17h-28z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="57.5"
                android:centerY="56.5"
                android:gradientRadius="12"
                android:type="radial">
                <item android:color="#99FF2A1A" android:offset="0.0" />
                <item android:color="#00FF2A1A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FF3A0A07"
        android:pathData="M31,54.5h5v4h-5z" />
    <path
        android:fillColor="#FF550E09"
        android:pathData="M37,54.5h5v4h-5z" />
    <path
        android:fillColor="#FF8A150D"
        android:pathData="M43,54.5h5v4h-5z" />
    <path
        android:fillColor="#FFC81E12"
        android:pathData="M49,54.5h5v4h-5z" />
    <path
        android:fillColor="#FFFF2A1A"
        android:pathData="M55,54.5h5v4h-5z" />
    <path
        android:fillColor="#FFE02414"
        android:pathData="M61,54.5h5v4h-5z" />
    <path
        android:fillColor="#FF6A0F0A"
        android:pathData="M67,54.5h5v4h-5z" />
    <path
        android:fillColor="#FF3A0A07"
        android:pathData="M73,54.5h5v4h-5z" />
    <!-- Hot core of the head lamp. -->
    <path
        android:fillColor="#FFFFC2B8"
        android:pathData="M56,55.5h3v2h-3z" />
    <!-- Lower grille slats. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,64.5H72M38,67.5H70"
        android:strokeColor="#FF2C2726"
        android:strokeWidth="1"
        android:strokeLineCap="round" />
    </group>
